{
  "name": "frc-challenge-lambda-functions",
  "version": "1.0.0",
  "description": "AWS Lambda functions for FRC Programming Challenge Platform",
  "main": "index.js",
  "scripts": {
    "build": "webpack --mode production",
    "deploy": "npm run build && node -r dotenv/config ./node_modules/serverless/bin/serverless.js deploy",
    "remove": "node -r dotenv/config ./node_modules/serverless/bin/serverless.js remove",
    "local": "docker-compose -f docker-compose.local-dev.yml up -d && node -r dotenv/config ./node_modules/serverless/bin/serverless.js offline start --stage dev",
    "local:stop": "docker-compose -f docker-compose.local-dev.yml down",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.840.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.658.1",
    "@aws-sdk/client-dynamodb": "^3.658.1",
    "@aws-sdk/client-ec2": "^3.842.0",
    "@aws-sdk/client-ecs": "^3.840.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "^3.840.0",
    "@aws-sdk/lib-dynamodb": "^3.658.1",
    "@types/jsonwebtoken": "^9.0.10",
    "aws-lambda": "^1.0.7",
    "aws-sdk": "^2.1691.0",
    "axios": "^1.10.0",
    "dotenv": "^16.4.5",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.7.5",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "eslint": "^9.12.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "serverless": "^3.38.0",
    "serverless-offline": "^13.8.1",
    "serverless-webpack": "^5.14.2",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "typescript": "^5.6.3",
    "webpack": "^5.95.0",
    "webpack-cli": "^6.0.1"
  },
  "keywords": [
    "aws",
    "lambda",
    "serverless",
    "frc",
    "robotics",
    "education",
    "typescript"
  ],
  "author": "FRC Challenge Platform",
  "license": "MIT"
}
